# Prefer DSH Settings > Plugins > Video Studio for API keys and models.
# For server environment mode, explicitly select "宿主环境变量" in that panel.
# Copy to .env, fill only needed providers, then export before launching DSH.
# This file is not loaded automatically. Do not commit real API keys.
DSH_VIDEO_ARK_API_KEY=
DSH_VIDEO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DSH_VIDEO_ARK_IMAGE_MODEL=
DSH_VIDEO_ARK_VIDEO_MODEL=
DSH_VIDEO_ARK_IMAGE_REFERENCES=0
DSH_VIDEO_ARK_VIDEO_REFERENCES=0
DSH_VIDEO_ARK_VIDEO_DURATIONS=5,10
# DSH_VIDEO_ARK_IMAGE_SIZE=2560x1440

DSH_VIDEO_TTS_API_KEY=
DSH_VIDEO_TTS_BASE_URL=https://api.openai.com/v1
DSH_VIDEO_TTS_MODEL=
DSH_VIDEO_TTS_VOICE=

# DSH_VIDEO_FFMPEG=/opt/homebrew/bin/ffmpeg
# DSH_VIDEO_FFPROBE=/opt/homebrew/bin/ffprobe
